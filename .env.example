# Django
# Value below is the local-dev default (see CLAUDE.md's `cp .env.example
# .env` setup). Any production/Atolla deployment MUST override this to
# config.settings.production — the Dockerfile's runtime stage already bakes
# that in as its own default, but if this key is filled in with the example
# value below in the Atolla console, it will override the image default and
# deploy with dev settings (DEBUG=True, SQLite).
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=changeme-dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (used only when DJANGO_SETTINGS_MODULE=config.settings.production)
# DB_* are what the Django app itself reads. POSTGRES_* below only bootstrap
# the sibling `postgres` container in docker-compose.prod.yml (the official
# postgres image's own env var convention) — for local use, set DB_NAME/
# DB_USER/DB_PASSWORD to the same values as POSTGRES_DB/POSTGRES_USER/
# POSTGRES_PASSWORD.
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=changeme
DB_HOST=postgres
DB_PORT=5432

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Huey (used only when DJANGO_SETTINGS_MODULE=config.settings.production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# l4py logging
L4PY_APP_NAME=django-template
L4PY_LOG_LEVEL_ROOT=INFO
L4PY_LOG_LEVEL_apps=DEBUG

# Email / SMTP interface
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@example.com
