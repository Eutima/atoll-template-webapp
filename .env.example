# Django
# Value below is the local-dev default (see CLAUDE.md's `cp .env.example
# .env` setup). Any production/Atolla deployment MUST override this to
# config.settings.production — the Dockerfile's runtime stage already bakes
# that in as its own default, but if this key is filled in with the example
# value below in the Atolla console, it will override the image default and
# deploy with dev settings (DEBUG=True, SQLite).
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=changeme-dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (used only when DJANGO_SETTINGS_MODULE=config.settings.production)
# docker-compose.prod.yml feeds these to the sibling `postgres` container as
# its POSTGRES_DB/USER/PASSWORD (the postgres image's own env var names).
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=changeme
DB_HOST=postgres
DB_PORT=5432

# Redis / Huey (used only when DJANGO_SETTINGS_MODULE=config.settings.production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# l4py logging
L4PY_APP_NAME=django-template
L4PY_LOG_LEVEL_ROOT=INFO
L4PY_LOG_LEVEL_apps=DEBUG

# Which login flow the app uses: "django" (email/password, default) or "helix" (Login with Helix below).
AUTH_PROVIDER=django

# Value below is the local-dev default (off). Production defaults to "True"
# when this key is unset — but since the Atolla console pre-fills the value
# below, a production/Atolla deployment MUST override this to True, or it
# will silently disable MFA.
MFA_ENABLED=False

# Optional: if both are set and no users exist yet, an initial superuser is
# created automatically the next time migrations run (see
# apps/authentication/apps.py). Leave blank to skip this.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Helix OAuth / OIDC ("Login with Helix" — apps/authentication + apps/shared/interfaces/helix)
HELIX_BASE_URL=https://helix.example.com
HELIX_OAUTH_CLIENT_ID=changeme
HELIX_OAUTH_CLIENT_SECRET=changeme
# Workspace this OAuth app is registered under; sent as the `tenant=` param
# at authorize time.
HELIX_OAUTH_TENANT=changeme
HELIX_OAUTH_REDIRECT_URI=http://localhost:8000/auth/helix/callback/
# Workspace a logged-in Helix user must belong to for this app to let them
# in (checked via GET /api/v1/tenants/ after login) — not necessarily the
# same workspace as HELIX_OAUTH_TENANT above.
HELIX_WORKSPACE_TENANT=changeme
